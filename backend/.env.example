# backend/.env 파일을 만들 때 이 파일을 복사해서 실제 값으로 채워주세요.
# cp .env.example .env

# MongoDB 연결 문자열 (로컬 MongoDB 또는 MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/babylion

# JWT 서명에 사용할 비밀 키. 추측하기 어려운 랜덤 문자열로 교체하세요.
JWT_SECRET=replace_with_a_long_random_secret

# 서버가 사용할 포트 (선택, 기본값 4000)
PORT=4000

# CORS를 허용할 프론트엔드(Vite) 주소
FRONTEND_URL=http://localhost:5173
